<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/alerts') %>

<section class="page-hero mb-4">
  <p class="eyebrow">Affiliate Sites</p>
  <h1 class="display-title">Featured affiliate and partner sites.</h1>
  <p class="lead-copy mb-0">All entries are placeholder content cards for launch-state presentation.</p>
</section>

<section class="row g-3">
  <% ['Creator Tools Hub', 'Media Asset Vault', 'ClipForge Studio', 'Forum Analytics Pro', 'Review Syndicate', 'Stream Suite'].forEach((name, i) => { %>
    <div class="col-md-6 col-xl-4">
      <article class="card border-0 shadow-sm h-100">
        <img src="https://picsum.photos/seed/affiliate-<%= i %>/900/420" class="card-img-top" alt="affiliate placeholder" />
        <div class="card-body d-flex flex-column">
          <h2 class="h5"><%= name %></h2>
          <p class="text-muted flex-grow-1">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Dictum non consectetur a erat nam at lectus urna duis.
          </p>
          <a href="#" class="btn btn-outline-accent">Visit Placeholder Site</a>
        </div>
      </article>
    </div>
  <% }) %>
</section>

<%- include('partials/footer') %>
