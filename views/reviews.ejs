<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/alerts') %>

<section class="page-hero mb-4">
  <p class="eyebrow">Reviews</p>
  <h1 class="display-title">Community review board with star ratings and commentary.</h1>
  <p class="lead-copy mb-0">Placeholder review content seeded to make the site feel active.</p>
</section>

<div class="row g-3">
  <% reviews.forEach((review) => { %>
    <div class="col-md-6 col-xl-4" id="review-<%= review.id %>">
      <article class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="h5 mb-0"><%= review.title %></h2>
            <span class="rating-badge"><%= '★'.repeat(review.rating) %></span>
          </div>
          <p class="flex-grow-1 text-truncate-4"><%= review.body %></p>
          <div class="small text-muted d-flex align-items-center gap-2">
            <img src="<%= review.avatar_url %>" alt="avatar" class="avatar-xs" />
            <a href="/profile/<%= review.username %>">@<%= review.username %></a>
            <span><%= formatDate(review.created_at) %></span>
          </div>
        </div>
      </article>
    </div>
  <% }) %>
</div>

<%- include('partials/pagination', { paging, baseUrl: '/reviews?page=' }) %>

<%- include('partials/footer') %>
