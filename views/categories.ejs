<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/alerts') %>

<section class="page-hero mb-4">
  <p class="eyebrow">Browse Categories</p>
  <h1 class="display-title">30+ forum categories ready for threads, media, and reviews.</h1>
  <p class="lead-copy mb-0">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore.</p>
</section>

<section class="row g-3">
  <% categoryRows.forEach((category) => { %>
    <div class="col-sm-6 col-lg-4 col-xxl-3">
      <article class="card h-100 border-0 shadow-sm category-card">
        <div class="card-body d-flex flex-column">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="material-icons-round category-icon"><%= category.icon %></span>
            <span class="badge rounded-pill text-bg-light"><%= category.thread_count %> threads</span>
          </div>
          <h2 class="h5"><%= category.name %></h2>
          <p class="text-muted flex-grow-1"><%= category.description %></p>
          <a href="/categories/<%= category.slug %>" class="btn btn-accent mt-2">Open Category</a>
        </div>
      </article>
    </div>
  <% }) %>
</section>

<%- include('partials/footer') %>
